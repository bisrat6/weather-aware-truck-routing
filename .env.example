# Copy to .env and fill in. NEVER commit .env.

# Django. Django does not load this file itself: export these in your shell.
# DJANGO_DEBUG defaults to off. With it off, DJANGO_SECRET_KEY is required (startup fails
# without it) and DJANGO_ALLOWED_HOSTS must list your host. Local dev: DJANGO_DEBUG=true.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Third-party API credentials (server-side only)
MAPBOX_TOKEN=

# Optional. Empty means no cross-origin frontend access.
FRONTEND_ORIGIN=

# Render supplies this automatically. It is added to allowed hosts when set.
RENDER_EXTERNAL_HOSTNAME=

# Multiplier applied to provider drive times to approximate a loaded truck
TRUCK_TIME_FACTOR=1.1
